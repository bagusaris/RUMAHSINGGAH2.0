APP_NAME="SIM-RSP Dinas Kesehatan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Konfigurasi Database (Gunakan pgsql atau mysql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simrsp_db
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dinkes.pemda.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi Tanda Tangan Elektronik (TTE) Resmi BSrE - BSSN
BSRE_ENDPOINT="https://esign-sandbox.bssn.go.id"
BSRE_API_KEY="bsre_api_key_resmi_dari_bssn"
BSRE_CLIENT_SECRET="bsre_client_secret"
BSRE_PASSPHRASE="passphrase_sertifikat_pejabat"
BSRE_MODE="sandbox" # Ganti 'production' untuk server instansi

# Parameter Identitas Instansi & Format Surat
DINKES_PROVINCE_NAME="PEMERINTAH PROVINSI JAWA TENGAH"
DINKES_CITY_NAME="KABUPATEN SEMARANG"
DINKES_AGENCY_NAME="DINAS KESEHATAN"
DINKES_LETTER_FORMAT="440/{SEQ}/DINKES-RSP/{ROMAN}/{YEAR}"
